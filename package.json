{
  "name": "oc-pg-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed:db": "tsx src/seed/seed-db.ts",
    "seed:files": "tsx src/seed/seed-files.ts",
    "import:production": "tsx src/seed/import-production.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "node tests/run.mjs",
    "reindex": "tsx src/rag/reindex-cli.ts"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/storage-blob": "^12.34.0",
    "@langchain/anthropic": "^1.6.6",
    "@langchain/core": "^1.5.0",
    "@langchain/openai": "^1.8.5",
    "@langchain/textsplitters": "1.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "langchain": "^1.6.7",
    "mammoth": "^1.13.0",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.11.10",
    "typescript": "~5.9.3"
  }
}
